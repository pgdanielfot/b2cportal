// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- FOT (internal) ----------

model FotUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  products    Product[]
  submissions Submission[]
}

// ---------- Product / form template ----------

model Product {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   FotUser @relation(fields: [createdById], references: [id])
  createdById String

  steps       Step[]
  submissions Submission[]
}

model Step {
  id           String  @id @default(cuid())
  title        String
  titleMs      String? // Bahasa Melayu translation, shown to B2C/Agent if set
  titleZh      String? // Mandarin translation, shown to B2C/Agent if set
  // Optional notice shown above this step's fields (e.g. a consent disclaimer)
  disclaimer   String?
  disclaimerMs String?
  disclaimerZh String?
  order        Int

  // Skip this step unless another field's answer matches:
  // { fieldId: string, operator: "equals" | "not_equals", value: string }
  condition Json?

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  fields Field[]

  @@index([productId])
}

enum FieldType {
  TEXT
  TEXTAREA
  URL
  DATE
  DROPDOWN
  FILE
}

model Field {
  id           String    @id @default(cuid())
  label        String
  labelMs      String? // Bahasa Melayu translation, shown to B2C/Agent if set
  labelZh      String? // Mandarin translation, shown to B2C/Agent if set
  type         FieldType
  required     Boolean   @default(false)
  order        Int

  // TEXT/TEXTAREA: max character length
  maxLength    Int?

  // DROPDOWN: JSON array of option strings, e.g. ["A","B"]
  options      Json?

  // FILE: constraints
  minFiles     Int?
  maxFiles     Int?
  maxSizeMb    Int?
  allowedTypes Json? // e.g. ["image/png","image/jpeg"]
  width        Int? // required exact width in px, if any
  height       Int? // required exact height in px, if any
  // FILE: link to a sample/reference image for this specific upload
  sampleUrl    String?

  // Hide this field unless another field's answer matches:
  // { fieldId: string, operator: "equals" | "not_equals", value: string }
  condition Json?

  step   Step   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId String

  values FieldValue[]

  @@index([stepId])
}

// ---------- Submission (the shareable link instance) ----------

enum SubmissionStatus {
  PENDING
  SUBMITTED
}

model Submission {
  id          String           @id @default(cuid())
  shareToken  String           @unique @default(cuid())
  soNumber    String
  status      SubmissionStatus @default(PENDING)
  archived    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  submittedAt DateTime?

  product   Product @relation(fields: [productId], references: [id])
  productId String

  createdBy   FotUser @relation(fields: [createdById], references: [id])
  createdById String

  values FieldValue[]

  @@index([productId])
  @@index([soNumber])
}

model FieldValue {
  id String @id @default(cuid())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId String

  // TEXT/TEXTAREA/DATE/DROPDOWN
  value String?

  // FILE: stored file references (JSON array of {url, name, size, type})
  files Json?

  @@unique([submissionId, fieldId])
  @@index([submissionId])
}
